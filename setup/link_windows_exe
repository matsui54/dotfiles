#!/usr/bin/env bash
set -eu

mkdir -p "$HOME/.local/bin"

link_if_exists() {
  local src="$1"
  local dest="$HOME/.local/bin/$2"
  if [[ -e "$src" ]]; then
    ln -sfnv "$src" "$dest"
  elif [[ -L "$dest" ]]; then
    rm -fv "$dest"
  fi
}

link_if_exists "/mnt/c/Windows/explorer.exe" "explorer.exe"
link_if_exists "/mnt/c/Windows/System32/cmd.exe" "cmd.exe"
link_if_exists "/mnt/c/Windows/System32/clip.exe" "clip.exe"
link_if_exists "/mnt/c/Program Files/PowerShell/7/pwsh.exe" "pwsh.exe"
