#!/usr/bin/env bash
set -eu

DOTDIR="${Dotdir:-$(cd "$(dirname "$0")/.." && pwd)}"
echo "Linking dotfiles from $DOTDIR..."

for f in .vimrc .gitconfig .latexmkrc .zshenv .zshrc .bashrc; do
  ln -sfnv "$DOTDIR/$f" "$HOME/$f"
done

mkdir -p "$HOME/.config" "$HOME/.local/bin"

ln -sfnv "$DOTDIR/nvim" "$HOME/.config/nvim"

for p in "$DOTDIR/.config"/*; do
  [[ -e "$p" ]] || continue
  name="$(basename "$p")"
  ln -sfnv "$p" "$HOME/.config/$name"
done

ln -sfnv "$DOTDIR/scripts/pkg.py" "$HOME/.local/bin/pkg"

if grep -qi microsoft /proc/version 2>/dev/null; then
  "$DOTDIR/setup/link_windows_exe"
  ln -sfnv "$DOTDIR/scripts/xdg-open" "$HOME/.local/bin/xdg-open"
fi
